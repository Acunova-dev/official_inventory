      "title": "Business",
      "description": "Business organization entity owning inventory data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "currency": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role and business ownership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "disabled": { "type": "boolean" },
        "lastLogin": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "businessId", "role"]
