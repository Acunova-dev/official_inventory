  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Business organization profile"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Products owned by the business"
    },
    "/businesses/{businessId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/businesses/{businessId}/productCategories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/businesses/{businessId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers"
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers"
    },
    "/businesses/{businessId}/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Stock audit movements"
    },
    "/businesses/{businessId}/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Quotation invoices"
    },
    "/businesses/{businessId}/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "Receipt payments"
    },
    "/businesses/{businessId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Customer invoices"
    },
    "/businesses/{businessId}/cashBook/{entryId}": {
      "schema": "CashBookEntry",
      "description": "Cash book records"
    },
    "/businesses/{businessId}/bankAccounts/{accountId}": {
      "schema": "BankAccount",
      "description": "Bank account entities"
    },
    "/businesses/{businessId}/bankTransactions/{txnId}": {
      "schema": "BankTransaction",
      "description": "Bank ledger transactions"
    },
    "/businesses/{businessId}/paymentVouchers/{voucherId}": {
      "schema": "PaymentVoucher",
      "description": "Payment disbursement vouchers"
    },
    "/businesses/{businessId}/purchaseOrders/{orderId}": {
      "schema": "PurchaseOrder",
      "description": "Purchase orders"
    },
    "/businesses/{businessId}/goodsReceivedNotes/{grnId}": {
      "schema": "GoodsReceivedNote",
      "description": "Goods received notes"
    },
    "/businesses/{businessId}/systemLogs/{logId}": {
      "schema": "SystemLog",
      "description": "System log events"
    },
    "/businesses/{businessId}/settings/company": {
      "schema": "CompanySettings",
      "description": "Company setting profile"
    },
    "/businesses/{businessId}/counters/{counterId}": {
      "schema": "Counter",
      "description": "Sequential counters"
    }
  }
